FROM node:22-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
  bash \
  ca-certificates \
  curl \
  git \
  golang-go \
  jq \
  python3 \
  python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && ln -sf /usr/lib/go-1.19/bin/go /usr/local/bin/go

RUN npm install -g @openai/codex@0.142.5 \
  && codex --version

COPY server/bin/multica /usr/local/bin/multica
COPY deploy/k8s/codex-runtimes/entrypoint.sh /usr/local/bin/multica-runtime-entrypoint
RUN chmod +x /usr/local/bin/multica-runtime-entrypoint

ENTRYPOINT ["/usr/local/bin/multica-runtime-entrypoint"]
